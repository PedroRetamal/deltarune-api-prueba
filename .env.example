# Variables para tu base de datos local (psql / fastapi dev)
DATABASE_URL=postgresql+psycopg://postgres:LA_CONTRASEÑA@localhost:5432/deltarune_db
DATABASE_URL_PSYCOPG=postgresql://postgres:LA_CONTRASEÑA@localhost:5432/deltarune_db
DATABASE_URL_TEST=postgresql+psycopg://postgres:LA_CONTRASEÑA@localhost:5432/deltarune_test_db

# Configuración de JWT
SECRET_KEY=CLAVE_SECRETA
ALGORITHM=HS256
EXPIRACION_MINUTOS=30

# Variables para Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ELIGE_UNA_CONTRASEÑA
POSTGRES_DB=deltarune_db
DATABASE_URL_DOCKER=postgresql+psycopg://postgres:LA_CONTRASEÑA@db:5432/deltarune_db
DATABASE_URL_PSYCOPG_DOCKER=postgresql://postgres:LA_CONTRASEÑA@db:5432/deltarune_db